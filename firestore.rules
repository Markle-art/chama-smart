/**
 * ChamaSmart Firestore Security Rules
 *
 * Core Philosophy:
 * This ruleset implements an Administrative Ownership model for writes, 
 * but allows read access for contributors (anonymous or registered) to support the "Join" flow.
 *
 * Data Structure:
 * - /users/{userId}: Private user profile data.
 * - /chamas/{chamaId}: High-level Chama metadata managed by an admin.
 * - /chamas/{chamaId}/members/{memberId}: Participants within a specific Chama.
 * - /chamas/{chamaId}/transactions/{transactionId}: M-Pesa transaction records.
 * - /chamas/{chamaId}/members/{memberId}/contributions/{contributionId}: Financial records.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdminOf(adminId) {
      return isSignedIn() && request.auth.uid == adminId;
    }

    function isExistingAdmin(adminId) {
      return resource != null && isAdminOf(adminId);
    }

    function isValidId(id) {
      return request.resource.data.id == id;
    }

    function isValidAdminField() {
      return request.resource.data.adminUserId == request.auth.uid;
    }

    function isImmutable(field) {
      return !(field in request.resource.data) || request.resource.data[field] == resource.data[field];
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) && resource != null && isImmutable('id');
      allow delete: if isOwner(userId) && resource != null;
    }

    match /chamas/{chamaId} {
      // Allow PUBLIC read access to a specific Chama for the Join page
      allow get: if true;
      
      // Listing chamas requires sign-in
      allow list: if isSignedIn();
      
      // Admin-only writes
      allow create: if isSignedIn() && isValidAdminField() && isValidId(chamaId);
      allow update: if isExistingAdmin(resource.data.adminUserId) && isImmutable('adminUserId') && isImmutable('id');
      allow delete: if isExistingAdmin(resource.data.adminUserId);
    }

    match /chamas/{chamaId}/members/{memberId} {
      // Allow members or admins to see membership data
      allow get: if true;
      allow list: if true;
      
      // Admin-only writes
      allow create: if isSignedIn() && isValidId(memberId);
      allow update: if isExistingAdmin(resource.data.adminUserId) && isImmutable('id');
      allow delete: if isExistingAdmin(resource.data.adminUserId);
    }

    match /chamas/{chamaId}/transactions/{transactionId} {
      // Allow admins to manage, and anonymous users to create records of their payments
      allow get, list: if isSignedIn();
      allow create: if true; // Public create for M-Pesa push logging
      allow update, delete: if isExistingAdmin(resource.data.adminUserId);
    }

    match /chamas/{chamaId}/members/{memberId}/contributions/{contributionId} {
      // Allow reading contributions for transparency
      allow get: if true;
      allow list: if true;
      
      // Administrative control for record keeping
      allow create: if isSignedIn() && isValidId(contributionId);
      allow update: if isExistingAdmin(resource.data.adminUserId);
      allow delete: if isExistingAdmin(resource.data.adminUserId);
    }
  }
}